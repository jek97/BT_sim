<?xml version="1.0" ?>
<sdf version="1.5">
  <model name="fence">
    <!-- NOT static=true (TEST CHANGE): Ignition/gz-sim contact sensors
         have a known limitation where they can fail to report contacts
         against purely static bodies - suspected root cause of the
         robot visibly getting physically wedged against a fence panel
         (confirmed via ground_truth/pose freezing mid-drive) while
         EVERY chassis/wheel contact topic stayed empty the whole time.
         Anchored rigidly to the world via a fixed joint below instead -
         immobile like a true static body, but a real dynamic link the
         contact system tracks, which is the standard workaround for
         this limitation. Needs a real (if arbitrary - it can never
         actually move) inertial block since it's no longer static. -->
    <link name="link">
      <pose>0 0 0.915 0 0 0</pose>
      <inertial>
        <mass>50.0</mass>
        <inertia>
          <ixx>1.0</ixx>
          <iyy>1.0</iyy>
          <izz>1.0</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <box>
            <size>0.1 5. 1.83</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <cast_shadows>false</cast_shadows>
        <geometry>
          <box>
            <size>0.1 5. 1.83</size>
          </box>
        </geometry>
        <material>
          <!-- Ogre2 doesn't support the old Ogre1 .material script format
               this used to reference (woodboarding.material): it silently
               fell back to a default (untextured) material instead of
               erroring. PBR's albedo_map is parsed natively, no script
               involved -- EXCEPT this project's own ign-gazebo6/ogre2
               build renders the PBR metal workflow as solid black
               regardless of metalness/roughness (confirmed with a
               minimal isolated world: even a plain, textureless
               <albedo> metal material with metalness=0 renders black;
               a plain classic ambient/diffuse/specular material next to
               it renders its real color fine). The classic ambient/
               diffuse/specular below is the actual fallback this
               renders with; the pbr/albedo_map block stays for
               renderers where PBR does work (a real GPU-rendered
               Ignition/Gazebo client, as opposed to this headless
               --headless-rendering + ogre2 combination) -- remove it
               only once PBR is confirmed working here too. -->
          <ambient>0.35 0.25 0.15 1</ambient>
          <diffuse>0.45 0.32 0.18 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://fence/materials/textures/woodboarding4.jpg</albedo_map>
              <metalness>0.0</metalness>
              <roughness>0.8</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
    <joint name="fence_fixed_to_world" type="fixed">
      <parent>world</parent>
      <child>link</child>
    </joint>
  </model>
</sdf>
