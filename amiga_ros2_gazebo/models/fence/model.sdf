<?xml version="1.0" ?>
<sdf version="1.5">
  <model name="fence">
    <static>true</static>
    <link name="link">
      <pose>0 0 0.915 0 0 0</pose>
      <collision name="collision">
        <geometry>
          <box>
            <size>0.1 5. 1.83</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <cast_shadows>false</cast_shadows>
        <geometry>
          <box>
            <size>0.1 5. 1.83</size>
          </box>
        </geometry>
        <material>
          <!-- Ogre2 doesn't support the old Ogre1 .material script format
               this used to reference (woodboarding.material): it silently
               fell back to a default (untextured) material instead of
               erroring. PBR's albedo_map is parsed natively, no script
               involved. -->
          <pbr>
            <metal>
              <albedo_map>model://fence/materials/textures/woodboarding4.jpg</albedo_map>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
