<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="fence">
    <static>true</static>
    <link name="link">
      <pose>0 0 0.915 0 0 0</pose>
      <collision name="collision">
        <geometry>
          <box>
            <size>0.1 5. 1.83</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <cast_shadows>false</cast_shadows>
        <geometry>
          <box>
            <size>0.1 5. 1.83</size>
          </box>
        </geometry>
        <material>
          <!-- Ogre2 doesn't support the old Ogre1 .material script format
               this used to reference (woodboarding.material): it silently
               fell back to a default (untextured) material instead of
               erroring. PBR's albedo_map is parsed natively, no script
               involved. -->
          <!-- SDF's plain ambient/diffuse default to pure black (0 0 0)
               when unset. If <pbr> fails to parse for any reason on this
               Ignition build, there would otherwise be no fallback color
               at all: explicit non-black values here guarantee the
               model shows as at least flat white/grey even in that case. -->
          <ambient>0.8 0.8 0.8 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://fence/materials/textures/woodboarding4.jpg</albedo_map>
              <!-- metalness/roughness default to ~1.0/~0.0 (a mirror-like
                   metal) when unset, which with no environment map to
                   reflect renders as solid black except for tiny specular
                   glints. This is a wood fence, not metal. -->
              <metalness>0.0</metalness>
              <roughness>0.8</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
