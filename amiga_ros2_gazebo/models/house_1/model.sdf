<?xml version="1.0" ?>
<sdf version="1.5">
  <model name="House 1">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://house_1/meshes/house_1.dae</uri>
            <scale>1.5 1.5 1.5</scale>
          </mesh>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://house_1/meshes/house_1.dae</uri>
            <scale>1.5 1.5 1.5</scale>
          </mesh>
        </geometry>
        <material>
          <!-- Ogre2 (Ignition Fortress's renderer) doesn't support the old
               Ogre1 .material script format at all: house_1.material's
               rtshader_system block in particular has no Ogre2 equivalent,
               so Ogre2 silently fell back to a default (white/black)
               material instead of erroring. PBR's albedo/normal maps are
               parsed natively by Ogre2, no script involved, so this also
               finally re-enables the normal map the old comment above gave
               up on. -->
          <pbr>
            <metal>
              <albedo_map>model://house_1/materials/textures/House_1_Diffuse.png</albedo_map>
              <normal_map>model://house_1/materials/textures/House_1_Normal.png</normal_map>
              <!-- metalness/roughness default to ~1.0/~0.0 (a mirror-like
                   metal) when unset, which with no environment map to
                   reflect renders as solid black except for tiny specular
                   glints. This is a house wall, not metal. -->
              <metalness>0.0</metalness>
              <roughness>0.7</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
