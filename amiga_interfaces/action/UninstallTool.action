# UninstallTool.action
#
# The mirror image of InstallTool.action -- same ports/mechanism, see
# that file's own header for the full story. Requires `tool` to be the
# tool CURRENTLY equipped (tool_action_node's own tracked state); on
# success, tool_action_node's tracked tool reverts to "free".

# "cart" or "plow" -- must be the tool CURRENTLY equipped.
string tool
---
# Result

# true iff the full Duration elapsed AND the coin flip succeeded --
# false for anything else (a failed coin flip, a safety cutoff, a
# cancel, a precondition failure).
bool status
---
# Feedback

# Wall-clock seconds elapsed since this action started.
float64 elapsed_s
